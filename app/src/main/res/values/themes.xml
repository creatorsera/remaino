<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">#0A0A0B</item>
        <item name="android:statusBarColor">#0A0A0B</item>
        <item name="android:navigationBarColor">#0A0A0B</item>
        <item name="android:colorAccent">#C8F26A</item>
    </style>

    <!-- Material 3 style dialog: large corner radius, tonal surface, lime actions. -->
    <style name="ReminoDialog" parent="android:Theme.DeviceDefault.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:colorAccent">#C8F26A</item>
        <item name="android:textColorPrimary">#F2F2F5</item>
        <item name="android:textColorSecondary">#94949E</item>
        <item name="android:windowMinWidthMajor">78%</item>
        <item name="android:windowMinWidthMinor">88%</item>
        <item name="android:windowNoTitle">false</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimAmount">0.6</item>
    </style>
</resources>
