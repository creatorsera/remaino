<?xml version="1.0" encoding="utf-8"?>
<com.remino.keyboard.SuggestionBar xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/kb_bar_height"
    android:background="@drawable/bg_suggestion_bar"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/kb_bar_margin"
    android:paddingEnd="@dimen/kb_bar_margin">

    <ImageButton
        android:id="@+id/bar_icon"
        android:layout_width="@dimen/kb_mascot"
        android:layout_height="@dimen/kb_mascot"
        android:layout_marginEnd="@dimen/kb_mascot_margin"
        android:background="@drawable/bg_mascot_badge"
        android:contentDescription="Options"
        android:padding="7dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_grid"
        android:tint="@color/kb_icon"
        android:visibility="gone" />

    <com.remino.keyboard.KeyMascotView
        android:id="@+id/mascot"
        android:layout_width="@dimen/kb_mascot"
        android:layout_height="@dimen/kb_mascot"
        android:layout_marginEnd="@dimen/kb_mascot_margin"
        android:contentDescription="Reo" />

    <LinearLayout
        android:id="@+id/suggestion_group"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/suggestion_0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/kb_text"
            android:textSize="14sp" />

        <View
            android:id="@+id/divider_1"
            android:layout_width="1dp"
            android:layout_height="18dp"
            android:background="@color/kb_divider" />

        <TextView
            android:id="@+id/suggestion_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/kb_text"
            android:textSize="14sp" />

        <View
            android:id="@+id/divider_2"
            android:layout_width="1dp"
            android:layout_height="18dp"
            android:background="@color/kb_divider" />

        <TextView
            android:id="@+id/suggestion_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/kb_text"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:paddingStart="6dp"
        android:textColor="@color/kb_text"
        android:textSize="13sp"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/mic"
        android:layout_width="@dimen/kb_mascot"
        android:layout_height="@dimen/kb_mascot"
        android:background="@null"
        android:contentDescription="Voice typing"
        android:padding="7dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_mic"
        android:tint="@color/kb_icon" />
</com.remino.keyboard.SuggestionBar>
