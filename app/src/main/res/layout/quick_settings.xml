<?xml version="1.0" encoding="utf-8"?>
<com.remino.keyboard.QuickSettingsView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_panel_top"
    android:fillViewport="true"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="Quick settings"
                android:textColor="@color/kb_text"
                android:textSize="16sp" />

            <ImageButton
                android:id="@+id/quick_close"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@null"
                android:contentDescription="Close"
                android:padding="8dp"
                android:src="@drawable/ic_close"
                android:tint="@color/kb_icon" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Appearance"
            android:textColor="@color/kb_text_dim"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/appearance_auto"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:text="Auto"
                android:textColor="@color/kb_text"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/appearance_light"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:text="Light"
                android:textColor="@color/kb_text"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/appearance_dark"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:text="Dark"
                android:textColor="@color/kb_text"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Feedback"
            android:textColor="@color/kb_text_dim"
            android:textSize="11sp" />

        <Switch
            android:id="@+id/toggle_haptics"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:text="Haptics"
            android:textColor="@color/kb_text"
            android:textSize="13sp" />

        <Switch
            android:id="@+id/toggle_sound"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:text="Key sound"
            android:textColor="@color/kb_text"
            android:textSize="13sp" />

        <Switch
            android:id="@+id/toggle_preview"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:text="Key preview"
            android:textColor="@color/kb_text"
            android:textSize="13sp" />

        <Switch
            android:id="@+id/toggle_floating"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:text="Floating keyboard"
            android:textColor="@color/kb_text"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Actions"
            android:textColor="@color/kb_text_dim"
            android:textSize="11sp" />

        <GridLayout
            android:id="@+id/action_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:columnCount="2"
            android:useDefaultMargins="false">

            <TextView
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_key_dark"
                android:gravity="center"
                android:tag="EMOJI"
                android:text="Emoji"
                android:textColor="@color/kb_text"
                android:textSize="13sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_key_dark"
                android:gravity="center"
                android:tag="CLIPBOARD"
                android:text="Clipboard"
                android:textColor="@color/kb_text"
                android:textSize="13sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_key_dark"
                android:gravity="center"
                android:tag="STICKER"
                android:text="Sticker"
                android:textColor="@color/kb_text"
                android:textSize="13sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_key_dark"
                android:gravity="center"
                android:tag="UNDO"
                android:text="Undo"
                android:textColor="@color/kb_text"
                android:textSize="13sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_key_dark"
                android:gravity="center"
                android:tag="REDO"
                android:text="Redo"
                android:textColor="@color/kb_text"
                android:textSize="13sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_key_dark"
                android:gravity="center"
                android:tag="LANGUAGE"
                android:text="Language"
                android:textColor="@color/kb_text"
                android:textSize="13sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_key_dark"
                android:gravity="center"
                android:tag="SETTINGS"
                android:text="Settings"
                android:textColor="@color/kb_text"
                android:textSize="13sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_key_dark"
                android:gravity="center"
                android:tag="HIDE"
                android:text="Hide"
                android:textColor="@color/kb_text"
                android:textSize="13sp" />
        </GridLayout>
    </LinearLayout>
</com.remino.keyboard.QuickSettingsView>
