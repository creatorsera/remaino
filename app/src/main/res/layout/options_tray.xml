<?xml version="1.0" encoding="utf-8"?>
<com.remino.keyboard.OptionsTrayView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:background="@drawable/bg_panel_top"
    android:fillViewport="true"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/options_icon_box"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_mascot_badge">

                <ImageView
                    android:id="@+id/options_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_grid" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/options_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Options"
                    android:textColor="@color/kb_text"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/options_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pick an action"
                    android:textColor="@color/kb_text_dim"
                    android:textSize="10sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/options_close"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@null"
                android:contentDescription="Close"
                android:padding="8dp"
                android:src="@drawable/ic_close"
                android:tint="@color/kb_icon" />
        </LinearLayout>

        <GridLayout
            android:id="@+id/action_grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp"
            android:columnCount="2"
            android:rowCount="3"
            android:useDefaultMargins="false" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/options_prev"
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:fontFamily="sans-serif-medium"
                android:text="‹"
                android:textColor="@color/kb_text_dim"
                android:textSize="22sp" />

            <LinearLayout
                android:id="@+id/options_page_dots"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/options_next"
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:fontFamily="sans-serif-medium"
                android:text="›"
                android:textColor="@color/kb_text_dim"
                android:textSize="22sp" />
        </LinearLayout>
    </LinearLayout>
</com.remino.keyboard.OptionsTrayView>
