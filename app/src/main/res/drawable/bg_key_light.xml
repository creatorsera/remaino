<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/kb_key_radius" />
            <solid android:color="@color/kb_light_key_edge" />
        </shape>
    </item>
    <item android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/kb_key_radius" />
            <solid android:color="@color/kb_light_key" />
        </shape>
    </item>
</layer-list>
